{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/i/:slug",
      "destination": "/api/invite?slug=:slug"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/aasa"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/s/:token/media",
      "destination": "/api/share-media?token=:token"
    },
    {
      "source": "/s/:token/poster",
      "destination": "/api/share-media?token=:token&kind=poster"
    },
    {
      "source": "/s/:token/request",
      "destination": "/api/share?token=:token&go=request"
    },
    {
      "source": "/s/:token",
      "destination": "/api/share?token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
