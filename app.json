{
  "expo": {
    "name": "VINTAGE",
    "slug": "vintage",
    "version": "1.0.0",
    "scheme": "vintage",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vintage.social",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "VINTAGE needs access to your photo library so you can share photographs.",
        "NSCameraUsageDescription": "VINTAGE needs camera access so you can take photographs to share.",
        "NSMicrophoneUsageDescription": "VINTAGE needs microphone access when you record short videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.vintage.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C1915",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "VINTAGE needs access to your photo library so you can share photographs."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
